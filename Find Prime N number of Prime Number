import java.util.*;
import java.util.Scanner;

class PrimeNumber{
  public static void prime(){

    Scanner sc=new Scanner(System.in);
    System.out.print("Enter The Number: ");
    int num=sc.nextInt();
    

    for(int i=2; i<=num; i++){
          boolean prime=true;
         for(int j=2; j<i; j++){
           if (i%j==0){
            prime=false;
            break;
           } 
         }
         if (prime){
          System.out.print(i + " ");
         } 
    }
  }
}

public class Main {
    public static void main(String[] args) {
     PrimeNumber.prime();
    }
}
